{
  "name": "@nukepayload2/data-grid",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "Drop-in antd Table replacement. CSS Grid under the hood. Fixes the bugs antd can't — resizable columns, virtual + summary coexistence, stable empty-data widths, scoped scrollTo. Same API, same look, same tokens as antd v6.",
  "keywords": [
    "antd",
    "antd-table",
    "ant-design",
    "replacement",
    "data-grid",
    "datagrid",
    "react-table",
    "react",
    "react19",
    "virtual",
    "virtualization",
    "resizable",
    "resizable-columns",
    "css-grid",
    "summary",
    "fixed-columns",
    "drop-in",
    "table"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "restore": "pnpm i",
    "build": "pnpm run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts && pnpm run build:types",
    "build:types": "tsc -p tsconfig.lib.json",
    "docs:api": "node scripts/extract-api.mjs",
    "build:docs": "pnpm docs:api && vite build --outDir dist-docs",
    "prepublishOnly": "pnpm run build:lib",
    "tsc": "tsc -b",
    "test": "vitest run && pnpm run test:css-compat",
    "test:css-compat": "node scripts/check-css-compat.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "lint": "oxlint . --ignore-path=.oxlintignore",
    "doctor": "react-doctor --blocking none --no-telemetry --output-dir docs/react-doctor-dump --json-out docs/react-doctor-report-stage6.json"
  },
  "dependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@ant-design/fast-color": "3.0.1",
    "@ant-design/icons": "^6.1.0"
  },
  "peerDependencies": {
    "antd": "^6.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-highlight-words": "^0.20.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "antd": "^6.1.0",
    "codemirror": "^6.0.2",
    "doiuse": "^6.0.6",
    "jsdom": "^29.1.1",
    "oxlint": "^0.15.0",
    "react": "^19.0.0",
    "react-doctor": "^0.7.1",
    "react-dom": "^19.0.0",
    "react-highlight-words": "^0.21.0",
    "sucrase": "^3.35.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^4.1.9"
  }
}
